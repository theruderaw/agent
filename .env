# ==========================================
# Application
# ==========================================

APP_NAME=agent
APP_ENV=development
DEBUG=true


# ==========================================
# Database
# ==========================================

DATABASE_URL=postgresql+psycopg://rudra:hello@localhost:5432/agent


# ==========================================
# Ollama
# ==========================================

OLLAMA_URL=http://localhost:11434

OLLAMA_BASE_MODEL=qwen2.5-coder:3b
OLLAMA_THINK_MODEL=qwen2.5-coder:7b

OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=120
OLLAMA_WRITE_TIMEOUT=40


# ==========================================
# Runtime
# ==========================================

MAX_ITERATIONS=50


# ==========================================
# Worker
# ==========================================

WORKER_CONCURRENCY=1